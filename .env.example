# Setlist.fm API Configuration
# Get your API key from: https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=your_api_key_here

# Development Mode (Optional)
# Set to 'true' to enable development features:
# - Only fetch first page of concerts (speeds up testing)
# - Enable debug logging
# NEVER enable in production!
DEV_MODE=false
